-- admission_reject.sql — I3 (v6 r18 C5, UC-2; CK-8, CK-29): a permanent
-- admission rejection (AR0) of a CAGRA and of an IVF-PQ build reaches the
-- user as SQLSTATE 54000 with the C5 errmsg, DETAIL and HINT, and is kept for
-- pg_cuvs_last_rejection(). AR0 is forced with the daemon's runtime budget
-- override (pg_cuvs_set_vram_budget), so the numbers are deterministic:
--   cagra 1000 x dim 8, gd 64: final 288,000 B, N = final + ceil(final x 7726
--   / 1000) = 2,513,088 B -> 2 MiB against a 1 MiB budget;
--   ivfpq 1000 x dim 8: 1000 x pq_dim 4 x 2 = 8,000 B against 4,096 B.
-- The budget is restored at the end.
\set ON_ERROR_STOP on
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pg_cuvs;
RESET client_min_messages;
SET cuvs.index_dir = '/tmp/cuvs_indexes';
SET max_parallel_maintenance_workers = 0;
-- No rejection yet in this session.
SELECT pg_cuvs_last_rejection() IS NULL AS no_rejection_yet;
 no_rejection_yet 
------------------
 t
(1 row)

CREATE TABLE ar_items (id int, embedding vector(8));
INSERT INTO ar_items
SELECT g, format('[%s,%s,0,0,0,0,0,1]', g, g % 7)::vector FROM generate_series(1, 1000) g;
SELECT pg_cuvs_set_vram_budget(1048576);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

\set ON_ERROR_STOP off
CREATE INDEX ar_cagra ON ar_items USING cagra (embedding vector_l2_ops);
ERROR:  pg_cuvs: GPU memory is insufficient for this CAGRA build (needs more than the configured limit); CREATE INDEX aborted
DETAIL:  needs 2 MiB; the limit for one build is 1 MiB (pool quota, or the logical VRAM budget when the pool is disabled)
HINT:  For a large table use pg_cuvs_hnsw with build_algo='auto' (it spills to ACE on disk when over budget) or build_algo='ace'. A lower graph_degree slightly lowers the admission estimate. Operators can review --rmm-pool-max-percent, --max-vram-mb and --rmm-scratch-permille.
\echo :LAST_ERROR_SQLSTATE
54000
\set ON_ERROR_STOP on
SELECT r->>'reason' AS reason, r->>'sqlstate' AS sqlstate, r->>'requester' AS requester,
       r->'fields' AS fields, r->'candidates' AS candidates, r->'shard' AS shard
FROM pg_cuvs_last_rejection() r;
 reason | sqlstate | requester |             fields              | candidates | shard 
--------+----------+-----------+---------------------------------+------------+-------
 AR0    | 54000    | BUILD     | {"need_mib": 2, "quota_mib": 1} | []         | null
(1 row)

SELECT pg_cuvs_set_vram_budget(4096);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

\set ON_ERROR_STOP off
CREATE INDEX ar_ivfpq ON ar_items USING ivfpq (embedding vector_l2_ops);
ERROR:  pg_cuvs: GPU memory is insufficient for this IVF-PQ build (needs more than the configured limit); CREATE INDEX aborted
DETAIL:  needs 0 MiB; the limit for one build is 0 MiB (pool quota, or the logical VRAM budget when the pool is disabled)
HINT:  For a large table use pg_cuvs_hnsw with build_algo='auto' (it spills to ACE on disk when over budget) or build_algo='ace'. Operators can review --rmm-pool-max-percent, --max-vram-mb and --rmm-scratch-permille.
\echo :LAST_ERROR_SQLSTATE
54000
\set ON_ERROR_STOP on
SELECT r->>'reason' AS reason, r->>'sqlstate' AS sqlstate,
       (r->>'index_oid')::oid <> 0 AS has_index_oid
FROM pg_cuvs_last_rejection() r;
 reason | sqlstate | has_index_oid 
--------+----------+---------------
 AR0    | 54000    | t
(1 row)

-- Sharded build (CK-36 (d')): 4000 rows in 2 shards of 2000, each
-- N = 576,000 + 4,450,176 = 5,026,176 B (4 MiB) against 3 MiB. The shard
-- rejection carries its shard number in DETAIL and in the jsonb.
CREATE TABLE ar_shard (id int, embedding vector(8));
INSERT INTO ar_shard
SELECT g, format('[%s,%s,0,0,0,0,1,0]', g, g % 11)::vector FROM generate_series(1, 4000) g;
SET cuvs.shard_count = 2;
SELECT pg_cuvs_set_vram_budget(3145728);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

\set ON_ERROR_STOP off
CREATE INDEX ar_sharded ON ar_shard USING cagra (embedding vector_l2_ops);
ERROR:  pg_cuvs: GPU memory is insufficient for this CAGRA build (needs more than the configured limit); CREATE INDEX aborted
DETAIL:  shard 0: needs 4 MiB; the limit for one build is 3 MiB (pool quota, or the logical VRAM budget when the pool is disabled)
HINT:  For a large table use pg_cuvs_hnsw with build_algo='auto' (it spills to ACE on disk when over budget) or build_algo='ace'. A lower graph_degree slightly lowers the admission estimate. Operators can review --rmm-pool-max-percent, --max-vram-mb and --rmm-scratch-permille. Or make room for one shard, or raise cuvs.shard_count to make the shards smaller.
\echo :LAST_ERROR_SQLSTATE
54000
\set ON_ERROR_STOP on
SELECT r->>'reason' AS reason, r->>'sqlstate' AS sqlstate, r->>'requester' AS requester,
       r->'shard' AS shard
FROM pg_cuvs_last_rejection() r;
 reason | sqlstate | requester | shard 
--------+----------+-----------+-------
 AR0    | 54000    | SHARD     | 0
(1 row)

RESET cuvs.shard_count;
-- Search-path reload rejection (C5 reload row): ar_a is evicted by an
-- admission under a tight budget (I2 LRU eviction, kept in the I3-A tip),
-- then queried under a budget below its final size, so the reload is refused.
SELECT pg_cuvs_set_vram_budget(0);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

CREATE TABLE ar_a (id int, embedding vector(8));
INSERT INTO ar_a
SELECT g, format('[%s,0,0,0,0,0,0,1]', g)::vector FROM generate_series(1, 1000) g;
CREATE INDEX ar_a_idx ON ar_a USING cagra (embedding vector_l2_ops);
CREATE TABLE ar_b (id int, embedding vector(8));
INSERT INTO ar_b
SELECT g, format('[0,%s,0,0,0,0,0,1]', g)::vector FROM generate_series(1, 1000) g;
-- 2,700,000 B: B's N (2,513,088) fits only after A (288,000) is evicted.
SELECT pg_cuvs_set_vram_budget(2700000);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

CREATE INDEX ar_b_idx ON ar_b USING cagra (embedding vector_l2_ops);
SELECT pg_cuvs_set_vram_budget(100000);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

SET enable_seqscan = off;
\set ON_ERROR_STOP off
SELECT id FROM ar_a ORDER BY embedding <-> '[3,0,0,0,0,0,0,1]'::vector LIMIT 1;
ERROR:  pg_cuvs: GPU memory is unavailable to load index "public.ar_a_idx"
DETAIL:  needs 0 MiB; the limit for one index is 0 MiB (pool quota, or the logical VRAM budget when the pool is disabled)
HINT:  The index is larger than the GPU memory limit of every GPU, so it cannot be loaded. An operator can raise --max-vram-mb or --rmm-pool-max-percent.
\echo :LAST_ERROR_SQLSTATE
53200
\set ON_ERROR_STOP on
RESET enable_seqscan;
SELECT r->>'reason' AS reason, r->>'sqlstate' AS sqlstate, r->>'requester' AS requester,
       (r->>'index_oid')::oid = 'ar_a_idx'::regclass AS is_ar_a
FROM pg_cuvs_last_rejection() r;
 reason | sqlstate | requester | is_ar_a 
--------+----------+-----------+---------
 AR0    | 53200    | LOAD      | t
(1 row)

SELECT pg_cuvs_set_vram_budget(0);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

SET client_min_messages = warning;   -- the reset NOTICE prints an OID
SELECT pg_cuvs_reset_circuit('ar_a_idx');
 pg_cuvs_reset_circuit 
-----------------------
 
(1 row)

RESET client_min_messages;
-- Restored budget: the same build is admitted.
SELECT pg_cuvs_set_vram_budget(0);
 pg_cuvs_set_vram_budget 
-------------------------
 
(1 row)

CREATE INDEX ar_cagra ON ar_items USING cagra (embedding vector_l2_ops);
SELECT pg_cuvs_last_rejection()->>'reason' AS last_reason_unchanged;
 last_reason_unchanged 
-----------------------
 AR0
(1 row)

DROP TABLE ar_items;
DROP TABLE ar_shard;
DROP TABLE ar_a;
DROP TABLE ar_b;
