-- cagra: a rolled-back TRUNCATE leaves the index as it was (still used, same answer)
CREATE TABLE ebs_cr (id int, v vector(4));
INSERT INTO ebs_cr SELECT g, ARRAY[g, 0, 0, 0]::real[]::vector FROM generate_series(1, 200) g;
CREATE INDEX ebs_cr_i ON ebs_cr USING cagra (v vector_l2_ops);
BEGIN;
TRUNCATE ebs_cr;
ROLLBACK;
SET enable_seqscan = off;
SELECT ebs_uses_index('SELECT id FROM ebs_cr ORDER BY v <-> ''[1,0,0,0]'' LIMIT 5') AS index_used;
 index_used 
------------
 t
(1 row)

SELECT string_agg(id::text, ',' ORDER BY d, id) AS ans FROM (SELECT id, v <-> '[1,0,0,0]' d FROM ebs_cr ORDER BY v <-> '[1,0,0,0]' LIMIT 5) s \gset
RESET enable_seqscan;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SELECT string_agg(id::text, ',' ORDER BY d, id) = :'ans' AS answers_like_the_heap FROM (SELECT id, v <-> '[1,0,0,0]' d FROM ebs_cr ORDER BY v <-> '[1,0,0,0]' LIMIT 5) s;
 answers_like_the_heap 
-----------------------
