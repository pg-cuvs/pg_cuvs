-- ivfpq
CREATE TABLE ebs_q (id int, v vector(4));
INSERT INTO ebs_q SELECT g, ARRAY[g, 0, 0, 0]::real[]::vector FROM generate_series(1, 200) g;
CREATE INDEX ebs_q_i ON ebs_q USING ivfpq (v vector_l2_ops) WITH (n_lists = 4, pq_bits = 8, pq_dim = 2);
SET enable_seqscan = off;
SELECT count(*) = 5 AS searched FROM (SELECT id FROM ebs_q ORDER BY v <-> '[1,0,0,0]' LIMIT 5) s;
 searched 
