+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <optional>
+#include <utility>
+#include <stdexcept>
+#include <string>
+
+namespace cuvs::neighbors::cagra::detail::memory_guard {
+
+inline size_t checked_add(size_t lhs, size_t rhs)
+{
+  if (rhs > std::numeric_limits<size_t>::max() - lhs) {
+    throw std::overflow_error("memory guard byte-count addition overflow");
+  }
+  return lhs + rhs;
+}
+
+inline size_t checked_mul(size_t lhs, size_t rhs)
+{
+  if (lhs != 0 && rhs > std::numeric_limits<size_t>::max() / lhs) {
+    throw std::overflow_error("memory guard byte-count multiplication overflow");
+  }
+  return lhs * rhs;
+}
+
+inline size_t checked_sum(std::initializer_list<size_t> values)
+{
+  size_t result = 0;
+  for (auto value : values) { result = checked_add(result, value); }
+  return result;
+}
+
+template <typename VectorType>
+inline size_t reorder_metadata_with_ends(size_t vector_metadata_bytes)
+{
+  return checked_sum({vector_metadata_bytes,
+                      checked_mul(size_t{2}, sizeof(size_t)),
+                      checked_mul(size_t{2}, sizeof(VectorType))});
+}
+
+inline size_t matrix_bytes(size_t rows, size_t cols, size_t element_bytes)
+{
+  return checked_mul(checked_mul(rows, cols), element_bytes);
+}
+
+inline size_t checked_scale(size_t value, double factor)
+{
+  if (!std::isfinite(factor) || factor < 0) {
+    throw std::invalid_argument("memory guard scale must be finite and nonnegative");
+  }
+  const long double scaled = static_cast<long double>(value) * factor;
+  const long double address_space_limit =
+    std::ldexp(1.0L, std::numeric_limits<size_t>::digits);
+  if (scaled >= address_space_limit) {
+    throw std::overflow_error("memory guard scaled byte count overflow");
+  }
+  return static_cast<size_t>(scaled);
+}
+
+inline std::optional<size_t> budget_bytes_from_gib(double gib)
+{
+  if (!std::isfinite(gib)) { throw std::invalid_argument("memory budget must be finite"); }
+  if (gib < 0) { throw std::invalid_argument("memory budget must not be negative"); }
+  if (gib == 0) { return std::nullopt; }
+
+  constexpr long double bytes_per_gib = 1024.0L * 1024.0L * 1024.0L;
+  const long double bytes = static_cast<long double>(gib) * bytes_per_gib;
+  const long double address_space_limit =
+    std::ldexp(1.0L, std::numeric_limits<size_t>::digits);
+  if (bytes < 1.0L || bytes >= address_space_limit) {
+    throw std::overflow_error("memory budget GiB value cannot be represented in bytes");
+  }
+  return static_cast<size_t>(bytes);
+}
+
+inline void require_within(const char* stage, size_t required, size_t budget)
+{
+  if (required > budget) {
+    throw std::length_error(std::string("memory guard: ") + stage + " requires " +
+                            std::to_string(required) + " bytes; budget is " +
+                            std::to_string(budget) + " bytes");
+  }
+}
+
+inline void require_within(const char* stage,
+                           size_t required,
+                           const std::optional<size_t>& budget)
+{
+  if (budget) { require_within(stage, required, *budget); }
+}
+
+inline size_t round_up(size_t value, size_t alignment)
+{
+  if (alignment == 0) { throw std::invalid_argument("memory guard alignment must be positive"); }
+  const size_t remainder = value % alignment;
+  return remainder == 0 ? value : checked_add(value, alignment - remainder);
+}
+
+inline size_t nn_descent_extended_degree(size_t degree)
+{
+  if (degree <= 32) { return round_up(degree, 32); }
+  return round_up(checked_mul(degree, size_t{13}) / 10, 32);
+}
+
+inline std::pair<size_t, size_t> nn_descent_workspace_bytes(size_t rows,
+                                                            size_t dim,
+                                                            size_t output_degree)
+{
+  if (rows == 0 || output_degree == 0) { return {0, 0}; }
+  const size_t graph_degree = nn_descent_extended_degree(output_degree);
+  const size_t internal_input = std::min(rows - 1, checked_mul(output_degree, size_t{2}));
+  const size_t internal_degree = nn_descent_extended_degree(internal_input);
+  // cuVS 26.04 NN-descent has seven N x NUM_SAMPLES host arrays (7*32*int),
+  // two N x int2 list-size arrays (2*8), and init_random_graph's N-int rand_seq
+  // in the worst one-segment case, totaling 916 bytes per row.
+  // Its host graph and distance arrays add two extended-degree float rows;
+  // the BloomFilter adds (512 bits / 32) * internal_degree = 2*internal_degree bytes.
+  const size_t per_row_host = checked_sum({
+    checked_mul(graph_degree, size_t{2 * sizeof(float)}),
+    size_t{912 + sizeof(uint32_t)},
+    checked_mul(internal_degree, size_t{2})});
+  // Device graph/distance rows (2*32*4), locks (4), two int2 sizes (16),
+  // and optional L2 norms (4) total 280. The returned device index also holds
+  // output_degree uint32 neighbors per row; float input staging costs at most 4*dim.
+  const size_t per_row_gpu = checked_sum({size_t{280},
+                                          checked_mul(output_degree, sizeof(uint32_t)),
+                                          checked_mul(dim, sizeof(float))});
+  return {checked_mul(rows, per_row_host), checked_mul(rows, per_row_gpu)};
+}
+
+inline bool hnsw_upper_level_uses_nn_descent(size_t rows,
+                                             size_t degree,
+                                             bool has_memory_budget)
+{
+  constexpr size_t nn_descent_neighbor_element_threshold = 10'000'000;
+  return checked_mul(rows, degree) < nn_descent_neighbor_element_threshold || has_memory_budget;
+}
+
+inline size_t hnsw_serializer_host_peak_bytes(size_t fixed_host_arrays_bytes,
+                                             size_t upper_builder_workspace_bytes,
+                                             size_t batch_bytes)
+{
+  return checked_sum(
+    {fixed_host_arrays_bytes, upper_builder_workspace_bytes, batch_bytes});
+}
+
+inline size_t hnsw_serializer_builder_host_budget(size_t host_budget_bytes,
+                                                  size_t fixed_host_arrays_bytes,
+                                                  size_t batch_bytes)
+{
+  const size_t live_bytes = checked_add(fixed_host_arrays_bytes, batch_bytes);
+  if (live_bytes > host_budget_bytes) {
+    throw std::length_error("memory guard: HNSW serializer live arrays exceed the host budget");
+  }
+  return host_budget_bytes - live_bytes;
+}
+
+inline size_t hnsw_order_arrays_bytes(size_t n_rows)
+{
+  constexpr size_t bytes_per_row = 2 * sizeof(size_t) + sizeof(int);
+  return checked_mul(n_rows, bytes_per_row);
+}
+
+inline size_t reorder_rows_per_buffer(size_t n_partitions,
+                                      size_t vector_bytes,
+                                      size_t budget_bytes,
+                                      size_t max_buffer_bytes = 64 * 1024 * 1024,
+                                      size_t minimum_rows      = 64)
+{
+  if (n_partitions == 0 || vector_bytes == 0 || minimum_rows == 0) {
+    throw std::invalid_argument("reorder buffer dimensions must be positive");
+  }
+
+  const size_t bytes_per_row_across_buffers = checked_mul(checked_mul(2, n_partitions), vector_bytes);
+  const size_t allowed_rows                 = budget_bytes / bytes_per_row_across_buffers;
+  if (allowed_rows < minimum_rows) {
+    throw std::length_error("memory guard: reorder buffers cannot fit the minimum row count");
+  }
+
+  const size_t max_rows = std::max(minimum_rows, max_buffer_bytes / vector_bytes);
+  return std::min(allowed_rows, max_rows);
+}
+
+}  // namespace cuvs::neighbors::cagra::detail::memory_guard
