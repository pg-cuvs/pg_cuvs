+++ b/cpp/src/neighbors/detail/cagra/consumer_row_sort_plan.hpp
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+namespace cuvs::neighbors::cagra::detail::consumer_row_sort {
+inline std::size_t checked_add(std::size_t a, std::size_t b)
+{
+  if (b > std::numeric_limits<std::size_t>::max() - a) {
+    throw std::overflow_error("consumer row sort byte addition overflow");
+  }
+  return a + b;
+}
+inline std::size_t checked_mul(std::size_t a, std::size_t b)
+{
+  if (a != 0 && b > std::numeric_limits<std::size_t>::max() / a) {
+    throw std::overflow_error("consumer row sort byte multiplication overflow");
+  }
+  return a * b;
+}
+inline std::size_t round_up(std::size_t n, std::size_t alignment)
+{
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0) {
+    throw std::invalid_argument("consumer row sort alignment must be a power of two");
+  }
+  auto remainder = n % alignment;
+  return remainder == 0 ? n : checked_add(n, alignment - remainder);
+}
+inline void validate_shape(std::size_t rows, std::size_t k,
+                           std::size_t input_stride, std::size_t output_stride)
+{
+  if (k == 0 || k > static_cast<std::size_t>(std::numeric_limits<int>::max()) ||
+      input_stride != k || output_stride != k) {
+    throw std::invalid_argument("consumer row sort requires packed complete rows and INT_MAX K");
+  }
+  auto items = checked_mul(rows, k);
+  if (items > static_cast<std::size_t>(std::numeric_limits<int64_t>::max()) ||
+      rows >= static_cast<std::size_t>(std::numeric_limits<int64_t>::max())) {
+    throw std::overflow_error("consumer row sort CUB item/offset range overflow");
+  }
+  (void)checked_mul(items, sizeof(int64_t));
+}
+struct plan {
+  std::size_t rows = 0;
+  std::size_t items = 0;
+  std::size_t offsets_bytes = 0;
+  std::size_t temp_offset = 0;
+  std::size_t temp_bytes = 0;
+  std::size_t allocation_bytes = 0;
+  std::size_t charged_bytes = 0;
+};
+template <typename Query>
+plan choose(std::size_t remaining_rows, std::size_t row_cap, std::size_t k,
+            std::size_t free_bytes, std::size_t mr_alignment, Query&& query)
+{
+  for (auto rows = std::min(remaining_rows, row_cap); rows != 0; rows /= 2) {
+    plan p;
+    p.rows          = rows;
+    try {
+      p.items         = checked_mul(rows, k);
+      p.offsets_bytes = checked_mul(checked_add(rows, 1), sizeof(int64_t));
+      p.temp_offset   = round_up(p.offsets_bytes, 256);  // CUB buffer starts aligned
+      // Prevent overflow inside pinned CUB's two-buffer size query. This is
+      // representability validation only; the real query below determines fit.
+      auto cub_bound = checked_add(round_up(checked_mul(p.items, sizeof(float)), 256),
+                                   round_up(checked_mul(p.items, sizeof(int64_t)), 256));
+      (void)checked_add(p.temp_offset, checked_add(cub_bound, 255));
+    } catch (const std::overflow_error&) {
+      continue;  // smaller rows, before any CUB query or allocation
+    }
+    p.temp_bytes    = query(rows, p.items);          // no allocation in this callback
+    p.allocation_bytes = checked_add(p.temp_offset, p.temp_bytes);
+    p.charged_bytes    = round_up(p.allocation_bytes, mr_alignment);
+    if (p.charged_bytes <= free_bytes) { return p; }
+  }
+  return {};
+}
+}  // namespace cuvs::neighbors::cagra::detail::consumer_row_sort
