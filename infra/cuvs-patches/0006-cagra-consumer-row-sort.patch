+// New scratch uses only the normal workspace MR; existing I/O allocators stay unchanged.
+// Pinned normal-MR accounting contract: default RMM alignment is 256 bytes.
+// Custom limiting-adaptor alignment is not publicly queryable in pinned RMM.
+inline void sort_cagra_consumer_rows(raft::resources const& res,
+                                     const float* distances, const int64_t* neighbors,
+                                     float* sorted_distances, int64_t* sorted_neighbors,
+                                     std::size_t rows, std::size_t k,
+                                     std::size_t input_stride, std::size_t output_stride,
+                                     cuvs::distance::DistanceType metric)
+{
+  using namespace consumer_row_sort;
+  validate_shape(rows, k, input_stride, output_stride);
+  auto stream = raft::resource::get_cuda_stream(res);
+  auto normal_mr = raft::resource::get_workspace_resource_ref(res);
+  auto const asc = cuvs::distance::is_min_close(metric);
+  constexpr std::size_t mr_alignment = 256;
+  std::size_t row_offset = 0;
+  std::size_t row_cap = rows;
+  while (row_offset < rows) {
+    auto element_offset = checked_mul(row_offset, k);
+    auto dispatch = [&](void* temp, std::size_t& bytes, std::size_t chunk_rows,
+                        const int64_t* offsets) {
+      auto const* end_offsets = offsets == nullptr ? nullptr : offsets + 1;
+      if (asc) {
+        return cub::DeviceSegmentedRadixSort::SortPairs(
+          temp, bytes, distances + element_offset, sorted_distances + element_offset,
+          neighbors + element_offset, sorted_neighbors + element_offset,
+          static_cast<int64_t>(checked_mul(chunk_rows, k)), static_cast<int64_t>(chunk_rows),
+          offsets, end_offsets, 0, 32, stream);
+      }
+      return cub::DeviceSegmentedRadixSort::SortPairsDescending(
+        temp, bytes, distances + element_offset, sorted_distances + element_offset,
+        neighbors + element_offset, sorted_neighbors + element_offset,
+        static_cast<int64_t>(checked_mul(chunk_rows, k)), static_cast<int64_t>(chunk_rows),
+        offsets, end_offsets, 0, 32, stream);
+    };
+    auto query = [&](std::size_t chunk_rows, std::size_t) {
+      std::size_t bytes = 0;
+      // The nullptr storage query returns before input access in pinned CUB.
+      RAFT_CUDA_TRY(dispatch(nullptr, bytes, chunk_rows, nullptr));
+      return bytes;
+    };
+    auto free_bytes = raft::resource::get_workspace_free_bytes(res);
+    plan chunk;
+    for (;;) {
+      chunk = choose(rows - row_offset, row_cap, k, free_bytes, mr_alignment, query);
+      if (chunk.rows == 0) {
+        throw rmm::out_of_memory("CAGRA consumer sort: normal workspace cannot fit one complete row");
+      }
+      auto free_now = raft::resource::get_workspace_free_bytes(res);
+      if (chunk.charged_bytes <= free_now) { break; }
+      free_bytes = free_now;
+      row_cap = chunk.rows;
+    }
+    rmm::device_buffer scratch(chunk.allocation_bytes, stream, normal_mr);
+    auto* offsets = static_cast<int64_t*>(scratch.data());
+    auto offset_view = raft::make_device_vector_view<int64_t, int64_t>(
+      offsets, static_cast<int64_t>(chunk.rows + 1));
+    raft::linalg::map_offset(res, offset_view, raft::mul_const_op<int64_t>{static_cast<int64_t>(k)});
+    auto* temp = static_cast<char*>(scratch.data()) + chunk.temp_offset;
+    auto actual_temp_bytes = chunk.temp_bytes;
+    RAFT_CUDA_TRY(dispatch(temp, actual_temp_bytes, chunk.rows, offsets));
+    row_offset += chunk.rows;
+    row_cap = chunk.rows;
+  }
+}
