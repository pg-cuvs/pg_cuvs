diff --git a/cpp/src/neighbors/detail/hnsw_precision.hpp b/cpp/src/neighbors/detail/hnsw_precision.hpp
new file mode 100644
--- /dev/null
+++ b/cpp/src/neighbors/detail/hnsw_precision.hpp
@@ -0,0 +1,41 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026, JAESOL SHIN
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+
+namespace cuvs::neighbors::hnsw::detail::upper_precision {
+
+// Policy bound shared with the product, not a proof of every PQ intermediate.
+inline double distance_bound(double max_sq_norm, bool is_l2)
+{
+  return is_l2 ? 4.0 * max_sq_norm : max_sq_norm;
+}
+
+inline bool needs_fp32(double max_sq_norm, bool is_l2)
+{
+  return !(distance_bound(max_sq_norm, is_l2) < 65504.0);
+}
+
+template <typename T>
+double max_sq_norm(const T* data, size_t rows, size_t dim)
+{
+  double maximum = 0.0;
+  for (size_t i = 0; i < rows; ++i) {
+    double squared = 0.0;
+    for (size_t j = 0; j < dim; ++j) {
+      const double value = static_cast<double>(data[i * dim + j]);
+      squared += value * value;
+    }
+    if (!std::isfinite(squared)) return std::numeric_limits<double>::infinity();
+    maximum = std::max(maximum, squared);
+  }
+  return maximum;
+}
+
+}  // namespace cuvs::neighbors::hnsw::detail::upper_precision
