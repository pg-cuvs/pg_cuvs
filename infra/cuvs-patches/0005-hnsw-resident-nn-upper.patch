@@ -11,6 +11,19 @@
 
 namespace cuvs::neighbors::hnsw::detail::upper_precision {
 
+/* NN's FP16 setting converts elements before float distance accumulation. */
+template <typename T>
+bool nn_input_needs_fp32(const T* data, size_t rows, size_t dim)
+{
+  for (size_t i = 0; i < rows; ++i) {
+    for (size_t j = 0; j < dim; ++j) {
+      const double value = static_cast<double>(data[i * dim + j]);
+      if (!std::isfinite(value) || std::abs(value) > 65504.0) return true;
+    }
+  }
+  return false;
+}
