+// Chooses the pruning kernel. The choice affects speed only: both kernels write identical output.
+template <int MAX_DEGREE, class IdxT>
+void launch_kern_prune(cudaStream_t stream,
+                       dim3 blocks,
+                       dim3 threads,
+                       const IdxT* const knn_graph,  // [graph_chunk_size, graph_degree]
+                       const uint32_t graph_size,
+                       const uint32_t graph_degree,
+                       const uint32_t degree,
+                       const uint32_t batch_size,
+                       const uint32_t batch_id,
+                       uint8_t* const detour_count,          // [graph_chunk_size, graph_degree]
+                       uint32_t* const num_no_detour_edges,  // [graph_size]
+                       uint64_t* const stats)
+{
+  if constexpr (std::is_same_v<IdxT, uint32_t>) {
+    if (graph_degree == kPruneRankIndexDegree) {
+      kern_prune_rank_index<kPruneRankIndexDegree, IdxT><<<blocks, threads, 0, stream>>>(
+        knn_graph,
+        graph_size,
+        graph_degree,
+        degree,
+        batch_size,
+        batch_id,
+        detour_count,
+        num_no_detour_edges,
+        stats);
+      return;
+    }
   }
+  kern_prune<MAX_DEGREE, IdxT><<<blocks, threads, 0, stream>>>(knn_graph,
+                                                                 graph_size,
+                                                                 graph_degree,
+                                                                 degree,
+                                                                 batch_size,
+                                                                 batch_id,
+                                                                 detour_count,
+                                                                 num_no_detour_edges,
+                                                                 stats);
 }
 
