+  // count number of detours (A->D->B)
+  for (uint32_t kAD = 0; kAD < graph_degree - 1; kAD++) {
+    const uint64_t iD = knn_graph[kAD + (graph_degree * iA)];
+    if (iD >= graph_size) { continue; }
+    for (uint32_t kDB = threadIdx.x; kDB < graph_degree; kDB += blockDim.x) {
+      const uint64_t iB_candidate = knn_graph[kDB + ((uint64_t)graph_degree * iD)];
+      // kern_prune's rule: the first rank kAB > kAD in A's row with ID iB_candidate. Candidate IDs
+      // are not filtered, so duplicate and out-of-range IDs match exactly as in kern_prune.
+      const uint64_t key = (iB_candidate << 32) | static_cast<uint64_t>(kAD + 1);
+      uint32_t lo = 0, hi = DEGREE;
+      while (lo < hi) {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        if (rank_index[mid] < key) {
+          lo = mid + 1;
+        } else {
+          hi = mid;
+        }
+      }
+      if (lo < DEGREE && (rank_index[lo] >> 32) == iB_candidate) {
+        const uint32_t kAB = static_cast<uint32_t>(rank_index[lo]);
+        atomicAdd(smem_num_detour + kAB, 1);
+      }
+    }
+    __syncthreads();
+  }
+
+  prune_finish_row(
+    smem_num_detour, graph_degree, degree, iA, detour_count, num_no_detour_edges, stats);
+}
