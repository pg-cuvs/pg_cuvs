+// Same result as kern_prune. kern_prune finds the first edge A->B' after kAD with B' == B by
+// scanning A's row for every (kAD, kDB) pair. Here the row is sorted once into rank_index, the keys
+// (ID << 32) | rank of its edges, and the first rank > kAD with that ID is a lower_bound on
+// (B << 32) | (kAD + 1). Only this auxiliary index is sorted; knn_graph is read-only.
+//
+// Supported launches (anything else is a bug in the caller, never a silent wrong result):
+//  - graph_degree == DEGREE: the shared arrays are sized by DEGREE, and the kernel traps otherwise.
+//    DEGREE is a power of two in [2, 1024] (bitonic network; 1024 is kern_prune's MAX_DEGREE).
+//  - IdxT == uint32_t: an ID must fit the 32 high bits of a key.
+//  - 32 threads per block: the row epilogue is a full-warp reduction, as in kern_prune.
+template <uint32_t DEGREE, class IdxT>
+__global__ void kern_prune_rank_index(
+  const IdxT* const knn_graph,  // [graph_chunk_size, graph_degree]
+  const uint32_t graph_size,
+  const uint32_t graph_degree,
+  const uint32_t degree,
+  const uint32_t batch_size,
+  const uint32_t batch_id,
+  uint8_t* const detour_count,          // [graph_chunk_size, graph_degree]
+  uint32_t* const num_no_detour_edges,  // [graph_size]
+  uint64_t* const stats)
+{
+  static_assert(std::is_same_v<IdxT, uint32_t>, "rank index keys pack a 32-bit ID");
+  static_assert(DEGREE >= 2 && DEGREE <= 1024 && (DEGREE & (DEGREE - 1)) == 0,
+                "the bitonic network needs a power-of-two DEGREE up to kern_prune's MAX_DEGREE");
+  if (graph_degree != DEGREE) { __trap(); }
+
+  __shared__ uint32_t smem_num_detour[DEGREE];
+  __shared__ uint64_t rank_index[DEGREE];
+
+  const uint64_t iA = blockIdx.x + (batch_size * batch_id);
+  if (iA >= graph_size) { return; }
+  prune_init_row(knn_graph, graph_degree, iA, smem_num_detour, rank_index);
+  __syncthreads();
+
+  // Bitonic sort of the unique keys (ID high 32 bits, original rank low 32 bits).
+  // No floating-point or tie handling: the order is total.
+  for (uint32_t width = 2; width <= DEGREE; width <<= 1) {
+    for (uint32_t stride = width >> 1; stride != 0; stride >>= 1) {
+      for (uint32_t i = threadIdx.x; i < DEGREE; i += blockDim.x) {
+        const uint32_t partner = i ^ stride;
+        if (partner > i) {
+          const uint64_t left = rank_index[i], right = rank_index[partner];
+          const bool ascending = (i & width) == 0;
+          if ((left > right) == ascending) {
+            rank_index[i]       = right;
+            rank_index[partner] = left;
+          }
+        }
+      }
+      __syncthreads();
+    }
   }
-  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 1);
-  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 2);
-  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 4);
-  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 8);
