+// kern_prune and kern_prune_rank_index share the row setup (prune_init_row) and the row epilogue
+// (prune_finish_row). They differ only in how a detour A->D->B is attributed to the edge A->B.
+
+// Zero the detour counters of row iA, giving self edges the lowest priority. When rank_index is not
+// nullptr, also fill rank_index[k] = (ID of edge k << 32) | k for kern_prune_rank_index.
+// knn_graph is [graph_size, graph_degree].
+template <class IdxT>
+__device__ __forceinline__ void prune_init_row(const IdxT* const knn_graph,
+                                               const uint32_t graph_degree,
+                                               const uint64_t iA,
+                                               uint32_t* const smem_num_detour,
+                                               uint64_t* const rank_index)
+{
+  for (uint32_t k = threadIdx.x; k < graph_degree; k += blockDim.x) {
+    smem_num_detour[k] = 0;
+    const auto id      = knn_graph[k + ((uint64_t)graph_degree * iA)];
+    if (id == iA) {
+      // Lower the priority of self-edge
+      smem_num_detour[k] = graph_degree;
+    }
+    if (rank_index != nullptr) { rank_index[k] = (static_cast<uint64_t>(id) << 32) | k; }
+  }
+}
+
+// Write the detour counts of row iA and update the statistics. Needs all 32 lanes of a warp.
+// detour_count is [graph_chunk_size, graph_degree], num_no_detour_edges is [graph_size].
+__device__ __forceinline__ void prune_finish_row(const uint32_t* const smem_num_detour,
+                                                 const uint32_t graph_degree,
+                                                 const uint32_t degree,
+                                                 const uint64_t iA,
+                                                 uint8_t* const detour_count,
+                                                 uint32_t* const num_no_detour_edges,
+                                                 uint64_t* const stats)
+{
+  uint64_t* const num_retain = stats;
+  uint64_t* const num_full   = stats + 1;
+
+  uint32_t num_edges_no_detour = 0;
+  for (uint32_t k = threadIdx.x; k < graph_degree; k += blockDim.x) {
+    detour_count[k + (graph_degree * iA)] = min(smem_num_detour[k], (uint32_t)255);
+    if (smem_num_detour[k] == 0) { num_edges_no_detour++; }
+  }
+  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 1);
+  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 2);
+  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 4);
+  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 8);
+  num_edges_no_detour += __shfl_xor_sync(0xffffffff, num_edges_no_detour, 16);
+  num_edges_no_detour = min(num_edges_no_detour, degree);
+
+  if (threadIdx.x == 0) {
+    num_no_detour_edges[iA] = num_edges_no_detour;
+    atomicAdd((unsigned long long int*)num_retain, (unsigned long long int)num_edges_no_detour);
+    if (num_edges_no_detour >= degree) { atomicAdd((unsigned long long int*)num_full, 1); }
+  }
+}
